# Required: your Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: model and effort for the editing agent (low = fastest replies)
EDITOR_MODEL=claude-opus-5-5
EDITOR_EFFORT=low

# Optional: speech-to-text for "add captions". Any OpenAI-compatible
# /v1/audio/transcriptions endpoint with word timestamps works, e.g. a hosted
# Whisper API or a self-hosted faster-whisper server.
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

PORT=3000
